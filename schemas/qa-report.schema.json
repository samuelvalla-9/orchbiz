{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchbiz.local/schemas/qa-report.schema.json",
  "title": "OrchBiz QA Report",
  "description": "clients/<client-slug>/qa/qa-report.json - produced by the QA & Security agent (Stage 4). A PASSED report must cite evidence and contain no open critical defects.",
  "type": "object",
  "required": ["clientSlug", "generatedAt", "status", "passed", "traceability", "defects", "securityChecks", "evidence"],
  "properties": {
    "clientSlug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "generatedAt": { "type": "string", "minLength": 10 },
    "status": { "enum": ["PASSED", "FAILED"] },
    "passed": { "type": "boolean" },
    "traceability": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["requirement", "deliverable", "status"],
        "properties": {
          "requirement": { "type": "string" },
          "deliverable": { "type": "string" },
          "status": { "enum": ["MET", "PARTIAL", "NOT_MET"] },
          "evidence": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "description", "owner", "status"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "enum": ["critical", "major", "minor"] },
          "description": { "type": "string" },
          "owner": {
            "enum": ["01-business-analyst", "02-solution-architect", "03-brand-and-content", "04-website-builder", "05-workflow-engineer", "06-qa-and-security", "07-deployment-and-handover", "operator"]
          },
          "status": { "enum": ["open", "fixed", "accepted-risk"] }
        },
        "additionalProperties": false
      }
    },
    "securityChecks": {
      "type": "object",
      "required": ["secretScan", "consentRecorded", "tenantIsolationVerified", "unverifiedClaimsFlagged"],
      "properties": {
        "secretScan": {
          "type": "object",
          "required": ["command", "exitCode"],
          "properties": {
            "command": { "type": "string" },
            "exitCode": { "type": "integer" },
            "findings": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "consentRecorded": { "type": "boolean" },
        "tenantIsolationVerified": { "type": "boolean" },
        "unverifiedClaimsFlagged": { "type": "boolean" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "reference", "result"],
        "properties": {
          "type": { "enum": ["cli", "schema-validation", "unit-test", "e2e-test", "accessibility", "webhook-smoke-test", "manual-review"] },
          "reference": { "type": "string", "description": "Command run or path under qa/evidence/." },
          "result": { "enum": ["pass", "fail"] },
          "exitCode": { "type": "integer" }
        },
        "additionalProperties": false
      }
    },
    "summary": { "type": "string" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "passed": { "const": true } } },
      "then": {
        "properties": {
          "status": { "const": "PASSED" },
          "evidence": {
            "minItems": 1,
            "contains": { "properties": { "type": { "not": { "const": "manual-review" } } } },
            "items": { "properties": { "result": { "const": "pass" } } }
          },
          "defects": {
            "not": { "contains": { "properties": { "severity": { "const": "critical" }, "status": { "const": "open" } } } }
          },
          "traceability": { "items": { "properties": { "status": { "const": "MET" } } } },
          "securityChecks": {
            "properties": {
              "secretScan": { "properties": { "exitCode": { "const": 0 } } },
              "consentRecorded": { "const": true },
              "tenantIsolationVerified": { "const": true },
              "unverifiedClaimsFlagged": { "const": true }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "PASSED" } } },
      "then": { "properties": { "passed": { "const": true } } }
    }
  ]
}
