{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchbiz.local/schemas/template.schema.json",
  "title": "OrchBiz Reusable Template Manifest Schema",
  "description": "Metadata contract required for every website or automation module in catalogue/",
  "type": "object",
  "required": [
    "id",
    "version",
    "category",
    "purpose",
    "inputSchema",
    "outputSchema",
    "dependencies",
    "supportedIntegrations",
    "configurationFields",
    "estimatedMonthlyCostUSD",
    "permissionsRequired",
    "testCases",
    "knownLimitations",
    "rollbackApproach"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "category": {
      "type": "string",
      "enum": ["website", "automation", "content"]
    },
    "purpose": {
      "type": "string",
      "minLength": 15
    },
    "inputSchema": {
      "type": "object",
      "description": "JSON Schema describing the configuration and content inputs required by this template"
    },
    "outputSchema": {
      "type": "object",
      "description": "JSON Schema describing the deliverable or runtime output produced by this template"
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "supportedIntegrations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "configurationFields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "type", "required", "description"],
        "properties": {
          "key": { "type": "string" },
          "type": { "type": "string" },
          "required": { "type": "boolean" },
          "default": {},
          "description": { "type": "string" }
        }
      }
    },
    "estimatedMonthlyCostUSD": {
      "type": "number",
      "minimum": 0
    },
    "permissionsRequired": {
      "type": "array",
      "items": { "type": "string" }
    },
    "testCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "expectedOutcome"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "expectedOutcome": { "type": "string" }
        }
      }
    },
    "knownLimitations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "rollbackApproach": {
      "type": "string"
    },
    "implementationStatus": {
      "type": "string",
      "enum": ["contract-only", "in-development", "tested"],
      "description": "contract-only: manifest exists but no tested implementation; agents must label generated configuration as drafts. tested: implementation and test cases pass in CI."
    }
  },
  "additionalProperties": false
}
