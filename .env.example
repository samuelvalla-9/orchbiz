# Copy to .env and replace every value. .env is git-ignored; never commit real values.
# Generate long random values, e.g. in PowerShell:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 40 | ForEach-Object {[char]$_})

POSTGRES_USER=orchbiz
POSTGRES_PASSWORD=change-me-postgres
N8N_ENCRYPTION_KEY=change-me-n8n-encryption
ORCHBIZ_ADMIN_TOKEN=change-me-admin
# Must equal the value stored in the n8n Header Auth credential LEAD_EVENTS_WEBHOOK_HEADER_REF
# (header name: X-OrchBiz-Token).
LEAD_EVENTS_WEBHOOK_TOKEN=change-me-webhook
ORCHBIZ_ALLOWED_ORIGINS=http://localhost:4200
TZ=Asia/Kolkata
